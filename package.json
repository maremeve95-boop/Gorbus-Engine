{
  "name": "gorbus-engine",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node prepare.mjs && vite --host 0.0.0.0",
    "build": "node prepare.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node prepare.mjs && node --check src/main.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "luau-web": "1.5.1",
    "three": "0.185.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "description": "Gorbus Engine 0.7 with full-game AI workflow, Luau preflight compilation, Puter account and usage management, Three.js and Rapier physics."
}
